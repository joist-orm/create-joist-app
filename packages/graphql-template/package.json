{
  "name": "graphql-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "env-cmd jest --runInBand",
    "codegen": "env-cmd yarn joist-codegen && yarn graphql-codegen",
    "graphql-codegen": "graphql-codegen --config graphql-codegen.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,graphql}\""
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@graphql-tools/graphql-file-loader": "^8.1.12",
    "@graphql-tools/load": "^8.1.8",
    "@graphql-tools/merge": "^9.1.7",
    "graphql": "^16.13.1",
    "joist-orm": "2.0.3-next.38",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-resolvers": "^5.1.7",
    "@homebound/graphql-typescript-possible-types": "^2.19.0",
    "@homebound/graphql-typescript-resolver-scaffolding": "^2.49.0",
    "@homebound/graphql-typescript-simple-resolvers": "^1.58.0",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "env-cmd": "^11.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
